{
  "name": "autopl-init",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx"
    ],
    "moduleNameMapper": {
      "\\.(mp3|wav|m4a|ogg|png|jpg|jpeg|gif)$": "<rootDir>/jest.fileMock.js",
      "^expo-audio$": "<rootDir>/__mocks__/expo-audio.js"
    }
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.0.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@react-native-community/slider": "5.1.2",
    "@react-navigation/drawer": "^7.9.4",
    "@react-navigation/native": "^7.1.33",
    "@react-navigation/native-stack": "^7.14.4",
    "expo": "~55.0.5",
    "expo-audio": "~55.0.8",
    "expo-document-picker": "^55.0.8",
    "expo-file-system": "^55.0.10",
    "expo-speech-recognition": "^3.1.1",
    "expo-status-bar": "~55.0.4",
    "react": "19.2.0",
    "react-native": "0.83.2",
    "react-native-gesture-handler": "^2.30.0",
    "react-native-paper": "^5.15.0",
    "react-native-reanimated": "^4.2.2",
    "react-native-safe-area-context": "^5.7.0",
    "react-native-screens": "^4.24.0",
    "react-native-track-player": "^4.1.2",
    "react-native-worklets": "^0.7.4",
    "zustand": "^5.0.11",
    "audio-route": "file:./modules/audio-route"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "jest": "^30.2.0",
    "jest-expo": "^55.0.9",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.2"
  },
  "private": true
}
